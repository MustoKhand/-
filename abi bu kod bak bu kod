import pygame
pygame.init()
genislik_yukseklik = (800, 600)
pencere = pygame.display.set_mode(genislik_yukseklik)

font_listesi=pygame.font.get_fonts()
for font in font_listesi:
  print(font)
  font_ismi=pygame.font.SysFont('arial', 30)

  yazi=font_ismi.render("abi lol yukle girek bi ara", True, (255, 255, 255))
  yazi_koordinant=yazi.get_rect()
  yazi_koordinant.topleft=(400, 300)
  durum=True
while durum:
  for etkinlik in pygame.event.get():
   if etkinlik.type == pygame.QUIT:
     durum=False
  pencere.blit(yazi, yazi_koordinant)
  pygame.display.update()
pygame.quit()